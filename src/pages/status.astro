---
import Base from "../layouts/Base.astro";
import CensusStatus from "../components/CensusStatus.vue";
---
<Base
  title="Index status — Relaton"
  description="Per-flavor freshness of the Relaton Index: record counts and the latest ingest for every SDO flavor."
>
  <main class="status-page">
    <div class="page-header">
      <h1>Index status</h1>
      <p class="page-subtitle">
        Per-flavor freshness of the Relaton Index, read live from the API —
        record counts and the most recent ingest wave for every source.
      </p>
    </div>
    <CensusStatus client:load />
  </main>
</Base>

<style>
  .status-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
</style>
